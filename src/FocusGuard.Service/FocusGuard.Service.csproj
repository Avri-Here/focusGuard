<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UserSecretsId>dotnet-FocusGuard.Service-2b4f965a-afb0-4325-b6b2-d33578e7461e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.8" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="ARSoft.Tools.Net" Version="3.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FocusGuard.Core\FocusGuard.Core.csproj" />
  </ItemGroup>

  <!--
    Firewall COM interop (NetFwTypeLib) will be added when FirewallManager is implemented (build step 4).
    Note: <COMReference> requires Visual Studio MSBuild; for `dotnet build` use a NuGet wrapper
    (e.g. WindowsFirewallHelper) or dynamic interop via Type.GetTypeFromProgID.
  -->
</Project>
