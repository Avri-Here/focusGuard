<Window x:Class="FocusGuard.Tray.Windows.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusGuard — admin"
        Width="340" Height="170"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="pack://application:,,,/Resources/AppIcon.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enter admin password" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PwdBox" Grid.Row="1" Margin="0,0,0,8"/>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#B00020" TextWrapping="Wrap"/>

        <DockPanel Grid.Row="3">
            <Button Content="Cancel" DockPanel.Dock="Right" Padding="12,4" Margin="6,0,0,0"
                    IsCancel="True" Click="OnCancelClick"/>
            <Button x:Name="OkButton" Content="OK" DockPanel.Dock="Right" Padding="12,4"
                    IsDefault="True" Click="OnOkClick"/>
        </DockPanel>
    </Grid>
</Window>
