<Window x:Class="FocusGuard.Tray.Windows.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border Background="#CC1F1F1F" CornerRadius="12" Padding="16,10" Margin="0">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="FocusGuard" Foreground="#80FFFFFF" VerticalAlignment="Center"
                       FontSize="11" Margin="0,0,12,0"/>
            <TextBlock x:Name="CountdownText" Text="00:00" Foreground="White"
                       FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
